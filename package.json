{
  "name": "explanimate-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Explanimate: paste a repo, X post or article, get a whiteboard explainer video and an editable board that opens in tldraw.com. Powered by Meta Muse models.",
  "license": "MIT",
  "author": "Cesar Salem (https://github.com/slubbles)",
  "homepage": "https://explanimate.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slubbles/explanimate.git"
  },
  "bugs": {
    "url": "https://github.com/slubbles/explanimate/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "explanimate": "tsx packages/cli/src/bin.ts",
    "set-user-limit": "tsx scripts/set-user-limit.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "pnpm --filter @explanimate/web dev",
    "dev": "pnpm --filter @explanimate/web dev",
    "icons:generate": "tsx scripts/gen-icon-pack.ts",
    "og:generate": "node apps/web/scripts/gen-og-image.mjs",
    "email-logo:generate": "node apps/web/scripts/gen-email-logo.mjs",
    "email-copy:generate": "node apps/web/scripts/gen-email-copy-icon.mjs",
    "test": "node --import tsx --import ./scripts/css-stub.mjs --test \"packages/*/test/*.test.ts\" \"apps/web/test/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "build": "pnpm --filter @explanimate/web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@explanimate/models": "workspace:^",
    "@explanimate/render": "workspace:^",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
